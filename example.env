# ============================================================
# Full-Stack Boilerplate — Environment Variables
# Copy this file to .env and fill in your values:
#   cp example.env .env
# ============================================================

# ─── Server ──────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── Database — PostgreSQL ───────────────────────────────────
# Standard connection (used by Prisma at runtime via PrismaPg adapter)
DATABASE_URL="postgresql://postgres:password@localhost:5432/boilerplate_db"

# Direct connection — used by Prisma CLI (migrate / introspect)
# Required for Supabase pgBouncer setups (pooler=true on DATABASE_URL).
# If using plain local PostgreSQL, set to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:password@localhost:5432/boilerplate_db"

# Supabase (optional — only if using Supabase instead of local PG)
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── AI Provider (for /api/v1/chat endpoint) ─────────────────
# Uncomment and fill in when wiring up the chat route
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ─── LangSmith tracing (optional) ────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=boilerplate

# ─── Auth (when implementing authentication) ─────────────────
# JWT_SECRET=your-super-secret-jwt-key-min-32-chars
# JWT_EXPIRES_IN=7d

# OAuth providers (uncomment when adding social login)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── Frontend (exposed to Vite via import.meta.env) ──────────
# VITE_API_URL=http://localhost:8080
# VITE_APP_NAME=Boilerplate

# ─── Maps (if adding a map feature) ──────────────────────────
# VITE_MAPBOX_TOKEN=your_mapbox_token_here
